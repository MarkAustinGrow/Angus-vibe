FROM python:3.12-slim

WORKDIR /app

# Copy necessary files
COPY requirements.coral.txt .
COPY config.py .
COPY supabase_client.py .
COPY youtube_client.py .
COPY angus_coral_agent.py .
COPY data /app/data

# Add a build argument to force cache invalidation
ARG CACHEBUST=1

# Install dependencies
RUN pip install --no-cache-dir -r requirements.coral.txt
RUN pip install --no-cache-dir supabase==2.15.1
RUN pip install --no-cache-dir google-api-python-client>=2.0.0 google-auth>=2.0.0 google-auth-oauthlib>=0.4.0 google-auth-httplib2>=0.1.0

# Set environment variables
ENV CORAL_SERVER_URL=https://coral.pushcollective.club/sse

# Run the Coral agent
CMD ["python", "angus_coral_agent.py"]
